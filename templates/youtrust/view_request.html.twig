{% extends 'base.html.twig' %}

{% block title %}YouTrust - Details de la demande{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .status-badge {
            font-size: 0.875rem;
        }
        .detail-card {
            border-left: 4px solid;
        }
        .detail-card.signature-request {
            border-left-color: #0d6efd;
        }
        .detail-card.documents {
            border-left-color: #6c757d;
        }
        .detail-card.signers {
            border-left-color: #198754;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('youtrust_dashboard') }}">YouTrust</a></li>
                <li class="breadcrumb-item"><a href="{{ path('youtrust_list_requests_page') }}">Demandes de signature</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                <i class="bi bi-file-earmark-text"></i> Details de la demande
            </h1>
            <a href="{{ path('youtrust_list_requests_page') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour a la liste
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                {# Signature Request Details #}
                <div class="card shadow-sm mb-4 detail-card detail-card-signature-request">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-file-earmark-text"></i> Demande de signature
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h5 class="card-title">{{ signature_request.name|default('N/A') }}</h5>
                                <p class="card-text text-muted">
                                    <strong>ID:</strong> <code>{{ signature_request.id }}</code>
                                </p>
                            </div>
                            <div class="col-md-6 text-md-end">
                                {% set status = signature_request.status|default('unknown') %}
                                {% if status == 'waiting' %}
                                    <span class="badge bg-warning status-badge">En attente</span>
                                {% elseif status == 'on_going' %}
                                    <span class="badge bg-primary status-badge">En cours</span>
                                {% elseif status == 'completed' %}
                                    <span class="badge bg-success status-badge">Termine</span>
                                {% elseif status == 'expired' %}
                                    <span class="badge bg-secondary status-badge">Expire</span>
                                {% elseif status == 'cancelled' %}
                                    <span class="badge bg-danger status-badge">Annule</span>
                                {% else %}
                                    <span class="badge bg-light text-dark status-badge">{{ status }}</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <strong>Date de creation:</strong> 
                                        {{ signature_request.created_at|date('Y-m-d H:i:s')|default('N/A') }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Date de fin:</strong> 
                                        {{ signature_request.finalized_at|date('Y-m-d H:i:s')|default('N/A') }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>ID Externe:</strong> 
                                        {{ signature_request.external_id|default('N/A') }}
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <strong>Mode de livraison:</strong> 
                                        {{ signature_request.delivery_mode|default('N/A') }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Fuseau horaire:</strong> 
                                        {{ signature_request.timezone|default('N/A') }}
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Locale:</strong> 
                                        {{ signature_request.audit_trail_locale|default('N/A') }}
                                    </li>
                                </ul>
                            </div>
                        </div>

                        {% if signature_request.status|default('unknown') != 'cancelled' %}
                            <div class="mt-3">
                                <form method="post" 
                                      action="{{ path('youtrust_cancel_request', {'id': signature_request.id}) }}"
                                      onsubmit="return confirm('Etes-vous sur de vouloir annuler cette demande de signature?')"
                                      class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-' ~ signature_request.id) }}">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-x-circle"></i> Annuler cette demande
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Documents Section #}
                <div class="card shadow-sm mb-4 detail-card detail-card-documents">
                    <div class="card-header bg-secondary text-white">
                        <i class="bi bi-file-earmark-pdf"></i> Documents ({% if documents is not empty %}{{ documents|length }}{% else %}0{% endif %})
                    </div>
                    <div class="card-body">
                        {% if documents is empty %}
                            <div class="alert alert-info mb-0">
                                Aucun document trouve pour cette demande de signature.
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Nom</th>
                                            <th>Nature</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for document in documents %}
                                            <tr>
                                                <td><code>{{ document.id|default('N/A') }}</code></td>
                                                <td>{{ document.name|default(document.file_name|default('N/A')) }}</td>
                                                <td>{{ document.nature|default('N/A') }}</td>
                                                <td>
                                                    {% if document.url is not empty %}
                                                        <a href="{{ document.url }}" 
                                                           class="btn btn-sm btn-outline-primary" 
                                                           target="_blank" title="Telecharger">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Signers Section #}
                <div class="card shadow-sm mb-4 detail-card detail-card-signers">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-people-fill"></i> Signataires ({% if signers is not empty %}{{ signers|length }}{% else %}0{% endif %})
                    </div>
                    <div class="card-body">
                        {% if signers is empty %}
                            <div class="alert alert-info mb-0">
                                Aucun signataire trouve pour cette demande de signature.
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Nom</th>
                                            <th>Email</th>
                                            <th>Etat</th>
                                            <th>Niveau de signature</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for signer in signers %}
                                            <tr>
                                                <td><code>{{ signer.id|default('N/A') }}</code></td>
                                                <td>
                                                    {{ signer.info.first_name|default('N/A') }} 
                                                    {{ signer.info.last_name|default('') }}
                                                </td>
                                                <td>{{ signer.info.email|default('N/A') }}</td>
                                                <td>
                                                    {% set signerStatus = signer.status|default('waiting') %}
                                                    {% if signerStatus == 'waiting' %}
                                                        <span class="badge bg-warning status-badge">En attente</span>
                                                    {% elseif signerStatus == 'on_going' %}
                                                        <span class="badge bg-primary status-badge">En cours</span>
                                                    {% elseif signerStatus == 'completed' %}
                                                        <span class="badge bg-success status-badge">Termine</span>
                                                    {% elseif signerStatus == 'expired' %}
                                                        <span class="badge bg-secondary status-badge">Expire</span>
                                                    {% elseif signerStatus == 'cancelled' %}
                                                        <span class="badge bg-danger status-badge">Annule</span>
                                                    {% else %}
                                                        <span class="badge bg-light text-dark status-badge">{{ signerStatus }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ signer.signature_level|default('N/A') }}</td>
                                                <td>
                                                    {% if signer.url is not empty %}
                                                        <a href="{{ signer.url }}" 
                                                           class="btn btn-sm btn-outline-primary" 
                                                           target="_blank" title="Voir">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <i class="bi bi-clock"></i> Timeline
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <strong>Cree le:</strong> {{ signature_request.created_at|date('Y-m-d H:i:s')|default('N/A') }}
                            </li>
                            {% if signature_request.activated_at is not empty %}
                                <li class="list-group-item">
                                    <strong>Active le:</strong> {{ signature_request.activated_at|date('Y-m-d H:i:s') }}
                                </li>
                            {% endif %}
                            {% if signature_request.finalized_at is not empty %}
                                <li class="list-group-item">
                                    <strong>Finalise le:</strong> {{ signature_request.finalized_at|date('Y-m-d H:i:s') }}
                                </li>
                            {% endif %}
                            {% if signature_request.expires_at is not empty %}
                                <li class="list-group-item">
                                    <strong>Expire le:</strong> {{ signature_request.expires_at|date('Y-m-d H:i:s') }}
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <i class="bi bi-info-circle"></i> Informations complementaires
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-5">Signataires ordonnes:</dt>
                            <dd class="col-sm-7">{{ signature_request.ordered_signers|default('N/A') ? 'Oui' : 'Non' }}</dd>

                            <dt class="col-sm-5">Smart Anchors:</dt>
                            <dd class="col-sm-7">{{ signature_request.smart_anchors_resolution|default('N/A') }}</dd>

                            <dt class="col-sm-5">Signataires autorises a refuser:</dt>
                            <dd class="col-sm-7">{{ signature_request.signers_allowed_to_decline|default('N/A') ? 'Oui' : 'Non' }}</dd>
                        </dl>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="{{ path('youtrust_list_requests_page') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Retour a la liste
                    </a>
                    <a href="{{ path('youtrust_dashboard') }}" class="btn btn-outline-primary">
                        <i class="bi bi-house"></i> Tableau de bord
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
