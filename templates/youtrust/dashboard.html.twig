{% extends 'base.html.twig' %}

{% block title %}YouTrust - Tableau de bord{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-hover:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
        }
        .status-badge {
            font-size: 0.875rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                <i class="bi bi-shield-check"></i> YouTrust
            </h1>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-hover shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-check2-circle text-primary fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="card-title mb-0">État du service</h5>
                            </div>
                        </div>
                        <div class="mt-3">
                            {% if is_configured %}
                                <span class="badge bg-success status-badge">Configure</span>
                                <p class="card-text mt-2 mb-1">
                                    <strong>URL API:</strong> <code>{{ api_base_url }}</code>
                                </p>
                                <p class="card-text mb-1">
                                    <strong>Clé API:</strong> <code>{{ api_key_masked }}</code>
                                </p>
                            {% else %}
                                <span class="badge bg-danger status-badge">Non configure</span>
                                <p class="card-text mt-2">
                                    Le service YouTrust n'est pas configure. Veuillez verifier vos variables d'environnement.
                                </p>
                            {% endif %}
                        </div>
                        <div class="mt-3">
                            <a href="{{ path('youtrust_health') }}" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-heart-pulse"></i> Voir le detail
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-hover shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-people-fill text-info fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="card-title mb-0">Demande complete</h5>
                            </div>
                        </div>
                        <p class="card-text">
                            Creer une demande de signature complete avec 3 signataires pour simuler un workflow reel.
                        </p>
                        <div class="mt-3">
                            <a href="{{ path('youtrust_complete_request_new') }}" class="btn btn-info">
                                <i class="bi bi-plus-lg"></i> Demande complete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-hover shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-list-ul text-warning fs-4"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="card-title mb-0">Mes demandes</h5>
                            </div>
                        </div>
                        <p class="card-text">
                            Visualiser toutes vos demandes de signature existantes et leur etat.
                        </p>
                        <div class="mt-3">
                            <a href="{{ path('youtrust_list_requests_page') }}" class="btn btn-warning">
                                <i class="bi bi-eye"></i> Voir les demandes
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="alert alert-info mt-4">
            <h4 class="alert-heading">
                <i class="bi bi-info-circle"></i> A propos de YouTrust
            </h4>
            <p>
                YouTrust (anciennement YouSign) est une plateforme de signature electronique qui permet de signer
                des documents de maniere securisee et juridique. Ce tableau de bord vous permet de tester
                l'integration de l'API YouTrust avec votre application Symfony.
            </p>
            <hr>
            <p class="mb-0">
                <strong>Note:</strong> Assurez-vous que votre cl API et votre URL de base sont correctement
                configures dans vos variables d'environnement pour que le service fonctionne correctement.
            </p>
        </div>
    </div>
{% endblock %}
